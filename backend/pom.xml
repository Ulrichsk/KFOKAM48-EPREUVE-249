<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/>
    </parent>

    <groupId>fr.kfokam48</groupId>
    <artifactId>kfokam48-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>kfokam48-backend</name>
    <description>KFOKAM48 : presence, depot d'exercices et relecture entre pairs</description>

    <properties>
        <!-- Java 17 impose par le sujet. Compilation en release 17 : le bytecode
             produit reste du Java 17 meme si le JDK local est plus recent. -->
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Validation des DTO d'entree : le champ manquant sort en 400 CHAMP_MANQUANT -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Schema porte par Flyway, jamais par Hibernate (ENF5) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- Pilote PostgreSQL : optionnel, pour brancher l'application sur une base
             externe via les variables d'environnement (KFOKAM48_DB_URL...). -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- H2 : base en memoire des tests (ENF9 : poste vierge, rien a installer)
             ET base de developpement/demonstration par defaut, en mode PostgreSQL.
             Meme famille SQL des deux cotes : les migrations Flyway servies ici sont
             exactement celles des tests. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Tests unitaires (*Test) executes par surefire pendant `test`. -->
            <!-- Tests d'integration (*IT) executes par failsafe pendant `verify`,
                 ce qui permet a `./mvnw verify` de tout couvrir (ENF9). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
